#version 430

layout(local_size_x = 128) in;

struct ParticleMetadata {
	uint vertexIndex;
	uint region;
	uint neighborOffset;
	uint neighborCount;
};

layout(std430, binding = 0) readonly buffer Positions { vec4 positions[]; };
layout(std430, binding = 1) readonly buffer CellHeads { int cellHeads[]; };
layout(std430, binding = 2) readonly buffer NextParticles { int nextParticles[]; };
layout(std430, binding = 3) readonly buffer Metadata { ParticleMetadata metadata[]; };
layout(std430, binding = 4) readonly buffer Neighbors { uint neighbors[]; };
layout(std430, binding = 5) buffer Corrections { ivec4 corrections[]; };

#ifdef LIBMMD_VULKAN
layout(push_constant) uniform Parameters {
	uint ParticleCount;
	uint HashMask;
	float CellSize;
	float MinimumDistance;
};
#else
uniform uint ParticleCount;
uniform uint HashMask;
uniform float CellSize;
uniform float MinimumDistance;
#endif

uint hashCell(ivec3 cell) {
	uvec3 value = uvec3(cell) * uvec3(73856093u, 19349663u, 83492791u);
	return (value.x ^ value.y ^ value.z) & HashMask;
}

bool connected(uint first, uint second) {
	ParticleMetadata source = metadata[first];
	for (uint index = 0; index < source.neighborCount; index++) {
		if (neighbors[source.neighborOffset + index] == second) return true;
	}
	return false;
}

void main() {
	uint first = gl_GlobalInvocationID.x;
	if (first >= ParticleCount) return;
	ivec3 center = ivec3(floor(positions[first].xyz / CellSize));
	for (int x = -1; x <= 1; x++) {
		for (int y = -1; y <= 1; y++) {
			for (int z = -1; z <= 1; z++) {
				int secondValue = cellHeads[hashCell(center + ivec3(x, y, z))];
				while (secondValue >= 0) {
					uint second = uint(secondValue);
					if (second > first && metadata[first].region == metadata[second].region && !connected(first, second)) {
						vec4 firstPosition = positions[first];
						vec4 secondPosition = positions[second];
						float weight = firstPosition.w + secondPosition.w;
						vec3 delta = firstPosition.xyz - secondPosition.xyz;
						float distanceSquared = dot(delta, delta);
						if (weight > 0.0 && distanceSquared < MinimumDistance * MinimumDistance) {
							float distance = sqrt(max(distanceSquared, 1e-8));
							vec3 normal = distanceSquared > 1e-8 ? delta / distance : vec3(1.0, 0.0, 0.0);
							vec3 correction = normal * (MinimumDistance - distance) / weight;
							ivec3 firstCorrection = ivec3(correction * firstPosition.w * 1000000.0);
							ivec3 secondCorrection = ivec3(-correction * secondPosition.w * 1000000.0);
							atomicAdd(corrections[first].x, firstCorrection.x);
							atomicAdd(corrections[first].y, firstCorrection.y);
							atomicAdd(corrections[first].z, firstCorrection.z);
							atomicAdd(corrections[first].w, 1);
							atomicAdd(corrections[second].x, secondCorrection.x);
							atomicAdd(corrections[second].y, secondCorrection.y);
							atomicAdd(corrections[second].z, secondCorrection.z);
							atomicAdd(corrections[second].w, 1);
						}
					}
					secondValue = nextParticles[second];
				}
			}
		}
	}
}
